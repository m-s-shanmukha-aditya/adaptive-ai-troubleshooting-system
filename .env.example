# Needed only for cloud fallback.
OPENROUTER_API_KEY=your_key_here

# Optional model used for cloud responses; defaults to openrouter/free.
OPENROUTER_MODEL=openrouter/free

# Set to "1" to learn on retrieval misses; both other learning gates must also be "1".
ENABLE_CLOUD_LEARNING=0

# Opt in to blueprint regex observations in runtime mode; learning requires exactly "1".
ENABLE_RULE_OBSERVATIONS=false

# Opt in to retrieving active provisional blueprints; learning requires exactly "1".
ENABLE_PROVISIONAL_BLUEPRINTS=0
